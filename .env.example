# ── Your gateway's own auth ──────────────────────────────────────────────
# Long random string. Generate with: openssl rand -hex 32
# Clients send: Authorization: Bearer <GATEWAY_SECRET>
GATEWAY_SECRET=

# ── Provider API keys (leave empty to skip that provider entirely) ───────
# Gemini:  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq:    https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cerebras:   https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# ── Upstash Redis (optional; rate limiting falls back to SQLite, then off) ─
# https://console.upstash.com/ → create a REST database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── SQLite storage via libSQL (optional; usage log + rate-limit fallback) ─
# Local dev:   LIBSQL_URL=file:data/gateway.db
# Vercel prod: LIBSQL_URL=libsql://you.turso.io  (Turso free tier, hosted SQLite)
#              LIBSQL_AUTH_TOKEN=...
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=
# Days to keep request_log rows (housekeeping prunes ~1% of writes)
LOG_RETENTION_DAYS=30

# ── Hermes Agent (a CLIENT, not a provider — configure on the agent side) ─
# Hermes Agent connects TO this gateway. In the agent run:  hermes model
# → Custom endpoint → base_url: https://<your-app>.vercel.app/v1
# API key = your GATEWAY_SECRET above.
# Model = any pinned id from GET /v1/models (e.g. gemini:gemini-2.5-flash).
# Hermes-family MODELS can still be used via OpenRouter if you want them:
#   OPENROUTER_MODEL=nousresearch/hermes-4-70b

# ── Model overrides (defaults are verified-current as of 2026-09) ────────
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
# openrouter/free = auto-router that picks any currently-live free model
OPENROUTER_MODEL=openrouter/free
CEREBRAS_MODEL=gpt-oss-120b

# ── Optional tuning (sane defaults; you rarely need these) ───────────────
# Per-provider timeout in ms (each hop / stream connect, not total)
PROVIDER_TIMEOUT_MS=8000
# Total time budget for one request across all fallbacks
GATEWAY_BUDGET_MS=28000
# Conservative per-minute caps with headroom below real free-tier limits
GEMINI_MAX_RPM=10
GROQ_MAX_RPM=25
OPENROUTER_MAX_RPM=15
CEREBRAS_MAX_RPM=25
# Set to "1" to echo the provider's raw JSON in responses (debugging)
GATEWAY_INCLUDE_RAW=
# Set to a specific origin (e.g. https://mysite.vercel.app) to allow browser calls
# NOTE: the built-in chat UI (public/, served at "/") talks to the API
# same-origin, so it needs NO CORS configuration at all. ALLOWED_ORIGIN is
# only for OTHER browser apps hosted on a different domain.
ALLOWED_ORIGIN=
# Optional attribution sent to OpenRouter
OPENROUTER_SITE_URL=
